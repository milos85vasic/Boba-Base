#!/usr/bin/env bash
set -euo pipefail

AUDIT_LOG=".git/ATMO_CONSTITUTION_AUDIT_LOG"
COMMIT_HASH=$(git rev-parse HEAD 2>/dev/null || echo "unknown")
BYPASS_MARKER=".git/ATMO_LAST_BYPASS_ATTEMPT"
BYPASS_FLAG="no"

if [ -f "$BYPASS_MARKER" ]; then
  BYPASS_FLAG="yes"
  rm -f "$BYPASS_MARKER"
fi

MUTATION_DETECTED="no"

# Build pattern strings indirectly to avoid self-matching (§11.4.75)
M1="MUT""ATED"
M2="// alwa""ys pass"
M3="# MUT""ATION"

MUTATION_PATTERNS=(
  "$M1"
  "$M2"
  "$M3"
)

for pattern in "${MUTATION_PATTERNS[@]}"; \
do
  if git diff-tree --no-commit-id -r "$COMMIT_HASH" 2>/dev/null | grep -q "$pattern"; then
    MUTATION_DETECTED="yes"
    break
  fi
done

TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

{
  echo "[$TIMESTAMP] commit=$COMMIT_HASH bypass=$BYPASS_FLAG mutation=$MUTATION_DETECTED"
  if [ "$MUTATION_DETECTED" = "yes" ]; then
    echo "  WARNING: mutation marker detected in committed files — §11.4.75 violation"
  fi
} >> "$AUDIT_LOG"

# BOB-077 (RD2-10) forensic capture — observes every commit that lands
# through THIS checkout's post-commit hook and appends a forensic record
# (committer identity, hostname, timezone offset, configured remotes) when
# the subject matches a closed Auto-commit/templated pattern. See
# scripts/hooks/auto-commit-forensic-capture.sh for the full mandate,
# the identified producing mechanism, and honest limitations (push-timing
# is not observable from post-commit alone). The `|| true` is deliberate,
# never an oversight: this hook must never affect its own exit status on
# a capture failure (§11.4.234 — hooks never gate commit/push).
FORENSIC_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
if [ -n "$FORENSIC_ROOT" ] && [ -x "$FORENSIC_ROOT/scripts/hooks/auto-commit-forensic-capture.sh" ]; then
  bash "$FORENSIC_ROOT/scripts/hooks/auto-commit-forensic-capture.sh" "$COMMIT_HASH" >/dev/null 2>&1 || true
fi

exit 0
