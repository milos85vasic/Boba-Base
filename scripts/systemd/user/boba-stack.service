# boba-stack.service — boba container stack (qBittorrent + Jackett +
# qbittorrent-proxy + boba-jackett), started via the project's own
# ./start.sh entrypoint per Hard Stop #3 (CLAUDE.md — container
# orchestration is owned exclusively by ./start.sh).
#
# Rationale: systemd handles the OUTERMOST lifecycle (auto-start at
# boot / user login, restart on host reboot, journalctl integration).
# ./start.sh handles the INNER orchestration (boba-ctl / podman-compose
# → containers). The two layers do not compete: systemd invokes
# start.sh; start.sh invokes boba-ctl; boba-ctl invokes the compose
# runtime. This preserves the "single container-orchestration owner"
# invariant.
#
# Design notes:
# - Type=oneshot + RemainAfterExit=yes — start.sh is not a daemon; it
#   starts containers and exits. Podman itself is the long-running
#   supervisor. systemd holds the "started" state until stop is issued.
# - --no-build — Angular is rebuilt out-of-band (or by an operator-run
#   `./start.sh` invocation). Skipping the build shaves ~10 s off boot.
# - TimeoutStartSec=300 — a first-boot image pull can take a minute or
#   two; give it headroom without failing prematurely.
# - Restart=on-failure — if start.sh itself exits with a non-zero code
#   (e.g. compose command errored) systemd retries after 30 s. Compose
#   itself has restart: unless-stopped on the containers for their own
#   crash recovery.
# - EnvironmentFile — optional; if ~/.qbit.env exists it seeds the
#   tracker credential env before start.sh runs. NOT tracked in git per
#   §11.4.10.
# - StartLimitIntervalSec / StartLimitBurst — MEASURED DEFECT, fixed
#   2026-08-21 (feature 002-user-owned-downloads, T030). This unit sets
#   RestartSec=30, but systemd's DEFAULT rate-limit window is 10 s
#   (verified live: `systemctl --user show boba-stack.service -p
#   StartLimitIntervalUSec -p StartLimitBurst` → 10s / 5). Restarts 30 s
#   apart therefore NEVER accumulate inside a 10 s window, so the default
#   limiter could never trip and a persistently-failing start.sh would
#   re-run a FULL stack start every 30 s, forever, silently. That matters
#   more now that start.sh is fail-closed on the ownership precondition
#   (FR-010): a genuine refusal is persistent by design. The window is
#   widened to 10 min / 3 tries so a real transient (image pull, network)
#   still self-heals, while a persistent refusal lands in `failed` where
#   `systemctl --user status` and `boba-svc status` show it — an opaque
#   forever-loop is exactly the blocked mechanism §11.4.234 forbids.
#
# ─── OWNERSHIP GATE: INHERITED, NEVER DUPLICATED ───────────────────────
# Feature 002-user-owned-downloads (FR-010 / FR-004d) requires the stack
# to refuse to start when a declared location cannot produce
# operator-owned files, and to repair pre-existing content first.
#
# That gate is NOT declared here as an ExecStartPre. It lives in exactly
# ONE place — start.sh's run_ownership_gate() — and this unit inherits it
# by delegating to start.sh. Two copies would be two things that can
# drift, and a systemd path whose gate had drifted from the start.sh path
# is precisely the contradiction FR-009 forbids. Whatever start.sh
# enforces, `systemctl --user start boba.target` enforces, by
# construction and with no further wiring.

[Unit]
Description=Boba stack — containers via ./start.sh
Documentation=file:///run/media/milosvasic/DATA4TB/Projects/boba/CLAUDE.md
After=network-online.target
Wants=network-online.target
PartOf=boba.target
# See the StartLimit note in the header: the default 10 s window cannot
# bound restarts that are 30 s apart, so it is set explicitly here.
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/run/media/milosvasic/DATA4TB/Projects/boba
EnvironmentFile=-%h/.qbit.env
# Tells start.sh that THIS unit invoked it, so its FR-009 divergence notice
# stays quiet on the path where systemd and reality already agree. systemd's own
# INVOCATION_ID cannot serve here: it is inherited by anything spawned under any
# unit — including the operator's terminal — so it answers "is a unit an
# ancestor of me", not "did boba-stack.service start me" (§11.4.201(7):
# assert the real condition, never a proxy for it).
Environment=BOBA_STARTED_BY=boba-stack.service
ExecStart=/usr/bin/bash -lc "./start.sh --no-build"
ExecStop=/usr/bin/bash -lc "./stop.sh"
TimeoutStartSec=300
TimeoutStopSec=120
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
# §CONST-033 host safety corollary: keep the OOM-selector's aim on this
# unit's own descendants (containers have oom_score_adj=500 baked into
# docker-compose.yml, biasing kernel OOM AWAY from user session).
OOMScoreAdjust=200

[Install]
WantedBy=boba.target
