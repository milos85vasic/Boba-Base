=== boba-resource-pressure-check.timer + .service unit files ===
--- .timer ---
# boba-resource-pressure-check.timer — hourly cadence for the proactive
# host-pressure probe (task #77 / BOB-076).
#
# Schedule:
#   OnBootSec=5min          — first fire 5 minutes after user-session boot
#                             (gives the boba stack + other login services
#                             time to settle before the first probe).
#   OnUnitActiveSec=1hour   — thereafter, once per hour measured from the
#                             END of the previous activation (so a slow
#                             run never causes back-to-back re-fires).
#   RandomizedDelaySec=5min — ±5 min jitter so this timer does not land on
#                             exactly the same wall-clock second as any
#                             other hourly cron/timer on the host, every
#                             single hour (thundering-herd avoidance,
#                             §12.6/§12.12 host-safety courtesy).
#   Persistent=true         — if the user session was logged out / host
#                             asleep at a scheduled fire time, systemd runs
#                             the missed activation as soon as the timer
#                             unit is next started (login) instead of
#                             silently skipping it — closes the exact gap
#                             a suspended/logged-out host would otherwise
#                             leave (this project's own forced-logout
#                             incidents are precisely why a monitoring gap
#                             here would be self-defeating).

[Unit]
Description=Hourly timer for boba-resource-pressure-check.service (task #77/BOB-076)
Documentation=file:///run/media/milosvasic/DATA4TB/Projects/boba/docs/scripts/install-resource-pressure-timer.md

[Timer]
OnBootSec=5min
OnUnitActiveSec=1hour
RandomizedDelaySec=5min
Persistent=true
Unit=boba-resource-pressure-check.service

[Install]
WantedBy=timers.target
--- .service ---
# boba-resource-pressure-check.service — hourly proactive host-pressure
# probe (task #77 / BOB-076 2nd forced-logout incident, 2026-08-18).
#
# Purpose:
#   Runs challenges/scripts/resource_pressure_signature_challenge.sh — the
#   5-signature detector of forced-logout-precursor conditions (runaway
#   RSS, thread-ceiling utilization, container EAGAIN cascades, user.slice
#   memory PSI, pathological-regex processes). The 2026-08-18 incident's
#   own triage found a §12.12 EAGAIN cascade ~5 minutes BEFORE the
#   user@1000.service SIGKILL — a leading indicator an hourly standing
#   check would have caught well before the kill.
#
# Design:
#   Type=oneshot — runs to completion once per activation, never a daemon.
#   ExecStart runs the challenge script DIRECTLY (no wrapper) so its own
#   exit code is preserved verbatim in `systemctl --user status` /
#   `journalctl --user -u boba-resource-pressure-check.service`:
#     exit 0 -> unit shows "inactive (dead)" with a clean journal (PASS)
#     exit 1 -> unit shows "failed" — this IS the desired loud signal per
#               the challenge's own header ("fail-loud BEFORE
#               user@1000.service gets SIGKILLed, not after"); the full
#               diagnostic (which signature tripped + corrective action)
#               lands in the journal for `journalctl --user -u
#               boba-resource-pressure-check.service -n 50` to surface.
#   No Restart= directive — a oneshot's "failed" status is itself the
#   alert; the TIMER (not this service) governs re-firing cadence, so
#   auto-restarting the service would duplicate/race the timer's own
#   OnUnitActiveSec schedule.
#   Deliberately NOT PartOf=/Wants=boba.target — host resource pressure
#   must be monitored regardless of whether the qBittorrent/Jackett stack
#   is up or down; this unit's lifecycle is fully independent of it.
#   §CONST-033 corollary (same bias as the other boba-* units): this is a
#   monitoring probe, not user-session-critical work, so it is a
#   preferred OOM victim ahead of the operator's interactive session.

[Unit]
Description=Boba resource-pressure signature probe (proactive forced-logout-precursor detector, task #77/BOB-076)
Documentation=file:///run/media/milosvasic/DATA4TB/Projects/boba/docs/incidents/2026-08-18-perceived-forced-logout-2nd.md
Documentation=file:///run/media/milosvasic/DATA4TB/Projects/boba/challenges/scripts/resource_pressure_signature_challenge.sh

[Service]
Type=oneshot
WorkingDirectory=/run/media/milosvasic/DATA4TB/Projects/boba
ExecStart=/usr/bin/env bash /run/media/milosvasic/DATA4TB/Projects/boba/challenges/scripts/resource_pressure_signature_challenge.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=60
OOMScoreAdjust=300

