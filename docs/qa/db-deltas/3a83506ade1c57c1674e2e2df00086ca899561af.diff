-INSERT INTO items VALUES('BOB-063','Task','Completed (→ Fixed.md)','Low','pirateiro test-isolation: add to conftest isolation + standing regression guard','pirateiro test-isolation: add to conftest isolation + standing regression guard',NULL,NULL,NULL,'Claude','','Fixed',unistr('## BOB-063 — pirateiro test-isolation: add to conftest isolation + standing regression guard\u000a\u000a**Status:** Completed (→ Fixed.md)\u000a**Type:** Task\u000a**Evidence:** docs/qa/BOB-063/evidence.md\u000a**Severity:** Low\u000a**Created-By:** Claude\u000a\u000atest_plugin_pirateiro.py injected sys.modules[''pirateiro''] at module scope with no teardown; pirateiro was the one root not covered by conftest _isolate_download_proxy_modules, so it leaked into later tests. Fixed by caching+re-registering+purging the stub per unit test; added a standing isolation guard. RED 1-fail -> GREEN, full suite 4122 passed x2 seeds.\u000a\u000a'),'section',NULL,NULL,NULL,'2026-08-21 17:06:06','2026-08-21 17:06:06',NULL,NULL,NULL,NULL,NULL);
