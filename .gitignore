# Scheduler runtime files.
# NOTE: '/*' not '/' — git cannot re-include a file whose PARENT DIR is
# excluded, so a bare 'config/merge-service/' would make the tracked config
# below un-addable (§11.4.30 tracked content is never gitignored; §11.4.234(D)
# the commit mechanism is always unblocked).
# Guard: tests/unit/test_tracked_files_are_addable.sh
config/merge-service/*
!config/merge-service/data-model.yaml
!config/merge-service/hooks.yaml
!config/merge-service/log_event.sh

