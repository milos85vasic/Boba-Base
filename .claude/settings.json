{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/constitution/scripts/hooks/guard-forbidden-commands.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "constitution/scripts/hooks/action_prefix_expand.sh"
          }
        ]
      }
    ]
  }
}
